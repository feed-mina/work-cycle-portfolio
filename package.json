{
  "name": "work-cycle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute work-cycle-db --local --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute work-cycle-db --local --file=./seed/seed.sql",
    "db:migrate": "wrangler d1 execute work-cycle-db --remote --file=./migrations/0001_init.sql",
    "db:seed": "wrangler d1 execute work-cycle-db --remote --file=./seed/seed.sql",
    "db:migrate2:local": "wrangler d1 execute work-cycle-db --local --file=./migrations/0002_m2.sql",
    "db:migrate2": "wrangler d1 execute work-cycle-db --remote --file=./migrations/0002_m2.sql",
    "db:migrate3:local": "wrangler d1 execute work-cycle-db --local --file=./migrations/0003_meeting_ai.sql",
    "db:migrate3": "wrangler d1 execute work-cycle-db --remote --file=./migrations/0003_meeting_ai.sql",
    "db:migrate4:local": "wrangler d1 execute work-cycle-db --local --file=./migrations/0004_habits.sql",
    "db:migrate4": "wrangler d1 execute work-cycle-db --remote --file=./migrations/0004_habits.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  }
}
